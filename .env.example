# Database
TRADE_DB_URL=sqlite:///trade.db

# API
TRADE_API_KEY=your_32_character_api_key_here
TRADE_WS_TOKEN=your_websocket_token_here

# Live Broker (Binance example)
TRADE_BROKER_API_KEY=your_binance_api_key
TRADE_BROKER_API_SECRET=your_binance_api_secret
TRADE_BROKER_BASE_URL=https://api.binance.com

# Alerts
TRADE_TELEGRAM_TOKEN=your_telegram_bot_token
TRADE_TELEGRAM_CHAT_ID=your_chat_id
TRADE_SMTP_HOST=smtp.gmail.com
TRADE_ALERT_EMAIL=alerts@example.com

# Logging
TRADE_LOG_LEVEL=INFO
TRADE_LOG_FORMAT=json
TRADE_CONFIG_PATH=config/default.yaml
